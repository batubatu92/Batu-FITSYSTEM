rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The user's own profile (goal, training level, dietary restrictions, notes)
    // feeds the askCoach Cloud Function's system prompt.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/dailyCheckIns/{date} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.date == date
        && request.resource.data.indicators is map;
    }

    // Written only by the onDailyCheckInWrite Cloud Function (Admin SDK bypasses rules).
    match /users/{uid}/disciplineScores/{date} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Connection status is public-ish metadata (no tokens); only the
    // stravaOAuthCallback Cloud Function may write it.
    match /users/{uid}/connections/{provider} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Gates access to the app; only the redeemAccessCode Cloud Function may
    // set unlocked, so a client can never grant itself access directly.
    match /users/{uid}/access/{doc} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Invite codes: usage counters are only mutated by redeemAccessCode.
    match /accessCodes/{code} {
      allow read, write: if false;
    }

    // Raw OAuth tokens and pending OAuth state never touch client rules.
    match /stravaTokens/{uid} {
      allow read, write: if false;
    }

    match /stravaOAuthStates/{stateId} {
      allow read, write: if false;
    }
  }
}

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
# Use the Hosting domain (<project-id>.web.app), NOT <project-id>.firebaseapp.com.
# Firebase Hosting proxies the /__/auth/* handler on its own domain, so keeping
# auth same-origin with the app avoids Safari ITP blocking the redirect/popup
# sign-in flow between two different Google-owned domains.
VITE_FIREBASE_AUTH_DOMAIN=batu-fit-system.web.app
VITE_FIREBASE_PROJECT_ID=batu-fit-system
VITE_FIREBASE_STORAGE_BUCKET=batu-fit-system.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Strava app (https://www.strava.com/settings/api) — client secret NEVER goes here,
# it's only used server-side by the Cloud Function (see functions/README below).
# Leave VITE_ENABLE_STRAVA unset/false until Cloud Functions are deployed (needs Blaze plan).
VITE_ENABLE_STRAVA=false
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_REDIRECT_URI=https://batu-fit-system.web.app/api/strava/callback

# Batu AI Coach chat — needs the askCoach Cloud Function (GEMINI_API_KEY secret) deployed.
VITE_ENABLE_COACH=false

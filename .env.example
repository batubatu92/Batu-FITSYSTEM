# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=batu-fit-system.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=batu-fit-system
VITE_FIREBASE_STORAGE_BUCKET=batu-fit-system.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Strava app (https://www.strava.com/settings/api) — client secret NEVER goes here,
# it's only used server-side by the Cloud Function (see functions/README below).
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_REDIRECT_URI=https://batu-fit-system.web.app/api/strava/callback
